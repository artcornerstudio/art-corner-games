{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-iq/formation.schema.json",
  "title": "Formation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "variant",
    "side",
    "description",
    "players"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "enum": [
        "tackle11",
        "flag5",
        "flag7"
      ]
    },
    "side": {
      "enum": [
        "offense",
        "defense"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "players": {
      "type": "array",
      "minItems": 5,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "maxLength": 3
          },
          "x": {
            "type": "number",
            "minimum": -27,
            "maximum": 27
          },
          "y": {
            "type": "number",
            "minimum": -20,
            "maximum": 70
          }
        }
      }
    }
  }
}
