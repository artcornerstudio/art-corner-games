{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-iq/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "unitId", "order", "title", "summary", "steps", "quiz"],
  "definitions": {
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "playId": { "type": "string" },
        "formationId": { "type": "string" },
        "highlight": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "unitId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 600 },
          "diagram": { "$ref": "#/definitions/diagram" }
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "prompt", "choices", "answer", "explanation"],
            "properties": {
              "type": { "const": "choice" },
              "prompt": { "type": "string", "minLength": 1 },
              "choices": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
              "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
              "explanation": { "type": "string", "minLength": 1 },
              "diagram": { "$ref": "#/definitions/diagram" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "prompt", "diagram", "target", "explanation"],
            "properties": {
              "type": { "const": "tap" },
              "prompt": { "type": "string", "minLength": 1 },
              "diagram": { "$ref": "#/definitions/diagram" },
              "target": { "type": "string" },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
