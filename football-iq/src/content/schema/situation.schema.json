{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-iq/situation.schema.json",
  "title": "Situation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "variant", "down", "distance", "yardLine", "options"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "variant": { "enum": ["tackle11", "flag5", "flag7"] },
    "down": { "type": "integer", "minimum": 1, "maximum": 4 },
    "distance": { "type": "integer", "minimum": 1, "maximum": 30 },
    "yardLine": { "type": "integer", "minimum": 1, "maximum": 99 },
    "context": { "type": "string", "maxLength": 200 },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verdict", "reason"],
        "properties": {
          "playId": { "type": "string" },
          "special": { "enum": ["punt", "field-goal"] },
          "verdict": { "enum": ["best", "ok", "bad"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  }
}
