# Copy to .env (never commit .env). Load it with: node --env-file=.env server.js
# ---- Stripe (Dashboard -> Developers -> API keys; use the test keys first) ----
STRIPE_SECRET_KEY=sk_test_PASTE_YOUR_TEST_KEY
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret (or what `stripe listen` prints)
STRIPE_WEBHOOK_SECRET=whsec_PASTE_FROM_STRIPE
# Dashboard -> Product catalog -> your product -> the one-time price's ID
STRIPE_PRICE_ID=price_PASTE_FROM_STRIPE
# What the paywall shows (the real amount is whatever the Stripe price says)
PRICE_LABEL=$4.99

# ---- This server ----
# 32+ random characters; signs the login cookie and the license codes. Changing it logs everyone out.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Where the game is reached from a browser (no trailing slash). Stripe sends buyers back here.
PUBLIC_URL=http://localhost:3000
PORT=3000
# The purchase database. In production point this at a persistent disk.
DB_PATH=./data/purchases.sqlite
# production turns on HTTPS-only redirects and Secure cookies (PUBLIC_URL must then be https://)
NODE_ENV=development
